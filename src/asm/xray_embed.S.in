/* xray_embed.S — generated by CMake configure_file
 * This file is preprocessed by the C preprocessor before assembly,
 * so #if / #ifdef work as expected.
 *
 * @XRAY_BINARY_PATH@ is substituted with the absolute path to the
 * xray binary at configure time.
 */

#if defined(__APPLE__)
/* ── macOS / Darwin ─────────────────────────────────────────────────────── */
    .section __TEXT,__const
    .global  _g_xray_data
    .align   4
_g_xray_data:
    .incbin "@XRAY_BINARY_PATH@"

#elif defined(_WIN32) || defined(__CYGWIN__)
/* ── Windows (MinGW-w64 / Clang) ────────────────────────────────────────── */
    .section .rdata,"dr"
    .global  g_xray_data
    .align   4
g_xray_data:
    .incbin "@XRAY_BINARY_PATH@"

#else
/* ── Linux / other Unix ─────────────────────────────────────────────────── */
    .section .rodata
    .global  g_xray_data
    .type    g_xray_data, @object
    .align   4
g_xray_data:
    .incbin "@XRAY_BINARY_PATH@"
#endif
